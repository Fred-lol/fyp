# Supabase PostgreSQL connection string. Do not commit the real value.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Optional override. Default is http://127.0.0.1:8000
AQUALOAD_TRACKING_API=http://127.0.0.1:8000

# Real password-reset OTP email delivery through Resend.
RESEND_API_KEY=re_your_resend_api_key
OTP_FROM_EMAIL=AquaLoad <no-reply@your-verified-domain.com>
# Long, unique value used only to hash OTPs and verification tokens.
OTP_PEPPER=replace_with_a_long_random_secret
